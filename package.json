{
  "name": "midimaker",
  "version": "0.1.0",
  "private": true,
  "description": "MIDI Vault Generator - searchable MIDI library + intelligent MIDI generator desktop app",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @midimaker/app",
    "smoke": "npm run smoke -w @midimaker/app",
    "test": "npm run test -w @midimaker/engine",
    "build": "npm run build -w @midimaker/app",
    "dist:win": "npm run dist:win -w @midimaker/app",
    "dist:mac": "npm run dist:mac -w @midimaker/app",
    "generate:samples": "tsx tools/generate-samples.ts",
    "generate:library": "tsx tools/generate-library.ts",
    "validate:library": "tsx tools/validate-library.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
